{
  "routes": [
    {
      "src": "^/api/(.*)$",
      "dest": "https://carrental-fejd.onrender.com/api/$1",
      "transforms": [
        {
          "type": "request.headers",
          "op": "delete",
          "target": {
            "key": "origin"
          }
        }
      ]
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "^/(.*)$",
      "dest": "/index.html"
    }
  ]
}